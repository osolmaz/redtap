{
  "name": "redtap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Passively captures Reddit posts as you browse, archives them to a private HF bucket, and serves them as a feed",
  "scripts": {
    "build": "node scripts/build-extension.mjs",
    "build:ext": "tsc -p extension/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p space/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run format && npm run lint && npm run typecheck && npm run coverage && npm run build",
    "serve": "node builder/src/serve.ts",
    "build:site": "node builder/src/build-site.ts",
    "ingest-daemon": "node builder/src/ingest-daemon.ts",
    "mutate": "stryker run",
    "lint:space": "eslint space/src"
  },
  "dependencies": {
    "@huggingface/hub": "^2.17.6",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "slophammer-ts": "^0.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  }
}
